# =============================================================================
# OpenTelemetry Configuration (service-scoped)
# =============================================================================
# Copy this file to .env and fill in your values.
# The .env file is gitignored and will NOT be committed to source control.
#
# These environment variables are read automatically by the OpenTelemetry SDK
# and by IronDocuments's built-in telemetry layer at startup.
#
# Docs: https://opentelemetry.io/docs/specs/otel/configuration/sdk-environment-variables/
# =============================================================================

# OTLP collector endpoint (required)
OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-collector.example.com/otlp

# OTLP transport protocol: http/protobuf | http/json | grpc
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# OTLP headers (key=value pairs, comma-separated for multiple)
# WARNING: Contains credentials — never commit real values to source control.
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer YOUR_TOKEN_HERE

# Logical service name reported in traces and metrics
OTEL_SERVICE_NAME=irondocuments

# Optional: disable IronDocuments's internal telemetry (does not affect OTEL)
# IRONDOCUMENTS_NO_TELEMETRY=1
