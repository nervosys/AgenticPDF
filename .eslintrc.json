{
    "env": {
        "browser": true,
        "es2021": true,
        "node": true
    },
    "extends": [
        "eslint:recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "plugins": [
        "@typescript-eslint"
    ],
    "rules": {
        "no-unused-vars": "off",
        "@typescript-eslint/no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "destructuredArrayIgnorePattern": "^_" }],
        "no-undef": "off",
        "no-console": "off",
        "no-case-declarations": "off",
        "no-prototype-builtins": "off"
    },
    "ignorePatterns": [
        "node_modules/",
        "dist/",
        "*.js",
        "*.d.ts"
    ]
}
