yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
*.tsbuildinfo

# Test coverage
coverage/
.nyc_output/

# Environment variables — ignore every .env variant, but keep the template.
# (Catches .env.production etc. so a file with real secrets can't slip in.)
.env
.env.*
!.env.example

# Secrets / credentials that must never be committed
*.pem
*.key
*.p12
*.pfx
id_rsa
*.cert

