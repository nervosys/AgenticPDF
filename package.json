{
  "name": "agenticpdf",
  "version": "1.0.0",
  "description": "Modern, TypeScript-native PDF processing library with streaming, AI integration, and performance optimizations. Production-ready with comprehensive features.",
  "main": "dist/agenticpdf.js",
  "types": "dist/agenticpdf.d.ts",
  "type": "module",
  "bin": {
    "apdf": "./cli.js",
    "agenticpdf": "./cli.js"
  },
  "scripts": {
    "cli": "npx tsx cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:clean": "rimraf dist && npm run build",
    "build:browser": "node scripts/build-browser.cjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest",
    "test:integration": "jest tests/integration",
    "test:verbose": "jest --verbose",
    "test:silent": "jest --silent",
    "lint": "eslint agenticpdf.ts",
    "lint:fix": "eslint agenticpdf.ts --fix",
    "typecheck": "tsc --noEmit",
    "dev": "npm run test:watch",
    "ci": "npm run typecheck && npm run lint && npm run test:coverage",
    "prepublishOnly": "npm run ci && npm run build",
    "prepare": "husky install || true",
    "examples": "npx tsx scripts/run-examples-simple.ts",
    "examples:interactive": "npx tsx scripts/run-examples-simple.ts",
    "examples:demo": "echo \"Open demos/examples-demo.html in your browser to run interactive examples\"",
    "examples:simple": "echo \"Open demos/simple-demo.html in your browser for a basic demo\"",
    "examples:help": "npx tsx scripts/run-examples-simple.ts -- --help",
    "serve": "npx http-server . -p 8080",
    "serve:demos": "npx http-server demos -p 8080",
    "start": "node server.cjs",
    "validate:workflows": "node scripts/validate-workflows.cjs",
    "security:audit": "npm audit --audit-level moderate",
    "security:fix": "npm audit fix",
    "setup:env": "node scripts/setup-env.cjs",
    "postinstall": "node scripts/setup-env.cjs"
  },
  "keywords": [
    "pdf",
    "typescript",
    "typescript-native",
    "streaming",
    "ai",
    "extraction",
    "parsing",
    "semantic",
    "embedding",
    "llm",
    "rag",
    "machine-learning",
    "document-processing",
    "web-workers",
    "single-file",
    "theme-toggle",
    "dark-mode",
    "viewer",
    "browser",
    "zero-dependencies",
    "pdf-viewer",
    "pdf-parser",
    "pdf-alternative"
  ],
  "author": "NERVOSYS <opensource@nervosys.ai>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/nervosys/AgenticPDF.git"
  },
  "bugs": {
    "url": "https://github.com/nervosys/AgenticPDF/issues"
  },
  "homepage": "https://github.com/nervosys/AgenticPDF#readme",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/nervosys"
    }
  ],
  "dependencies": {
    "tsx": "^4.20.5"
  },
  "optionalDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0"
  },
  "overrides": {
    "minimatch@^9.0.0": "^9.0.9"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.40.0",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jsdom": "^28.1.0",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.40.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.1",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/agenticpdf.d.ts",
      "import": "./dist/agenticpdf.js"
    },
    "./otel": {
      "types": "./dist/otel.d.ts",
      "import": "./dist/otel.js"
    }
  },
  "files": [
    "dist",
    "cli.js",
    "cli.ts",
    "agenticpdf.ts",
    "otel.ts",
    ".env.example",
    "scripts/setup-env.cjs",
    "README.md",
    "LICENSE",
    "LICENSE-AGPL.txt",
    "CHANGELOG.md"
  ]
}
